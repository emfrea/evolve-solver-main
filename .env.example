# Copy to .env (gitignored) so a detached campaign self-authenticates the claude CLI.
# The autonomous loop (scripts/run_evolution_step.py) loads this at startup.

# Claude Code OAuth token (from `claude setup-token`). Treat like a password.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-REPLACE_ME

# Optional: override the default model used by agents.
# EVOLVE_MODEL=opus
